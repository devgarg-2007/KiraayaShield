# KiraayaShield Backend Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name
MONGODB_DATABASE=kiraayashield

# Backend server port
PORT=8000

# Allowed CORS origin(s) — comma-separated if multiple
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# GroqCloud API Key (for LLM lease analysis)
GROQ_API_KEY=your_groq_api_key_here

# TinyFish API Key (for market rate investigation)
TINYFISH_API_KEY=your_tinyfish_api_key_here
